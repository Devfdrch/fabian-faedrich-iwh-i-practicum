doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Favorite Dishes
        .cards
            each dish in data
                .card
                    h2.card__name #{dish.properties.name}
                    p.card__calories #{dish.properties.calories}
                    p.card__healthy #{dish.properties.healthy}
